{
  "manifest_version": 3,
  "name": "My Pigeon",
  "version": "0.1.1",
  "description": "A small pigeon that wanders around Chrome pages.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "My Pigeon",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sprites/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
